APP_NAME="Sekolah Kita"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
TRUSTED_PROXIES=
TRUSTED_HOSTS=localhost,127.0.0.1

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sekolah_kita
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE is derived from APP_ENV in production; set it
# explicitly only when TLS terminates somewhere this application cannot see.
SESSION_SAME_SITE=lax
SESSION_IDLE_TIMEOUT=30

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
NOTIFICATION_QUEUE=notifications
NOTIFICATION_EMAIL_ENABLED=true
AUDIT_FAILURE_MODE=throw
AUDIT_RETENTION_DAYS=
PPDB_CONSENT_VERSION=2026-01
PPDB_ACCESS_TOKEN_TTL_DAYS=7
PPDB_MAX_DOCUMENT_BYTES=10485760
# The applicant portal. Turning this off hides the registration form and closes
# the portal routes, while leaving an application that is already in progress
# readable — an administrator still needs to finish what has started.
PPDB_PORTAL_ENABLED=true

# WhatsApp is the second notification channel and is OFF unless a driver is
# named. With no driver, every WhatsApp attempt is recorded as
# `not_configured` and nothing claims a message was sent; the in-app
# notification is unaffected.
#
#   null   - no gateway at all; every attempt is recorded as not_configured
#   fonnte - https://fonnte.com, needs FONNTE_TOKEN
#   fake   - in-memory, for tests and demos; never for production
WHATSAPP_DRIVER=null
WHATSAPP_QUEUE=notifications
WHATSAPP_FROM=
WHATSAPP_TRIES=3
# Retry backoff in seconds, one value per attempt.
WHATSAPP_BACKOFF=30,120,600
FONNTE_TOKEN=

# The weekly timetable. allowed_days uses ISO-8601 day numbers: 1 = Monday,
# 7 = Sunday. Sunday is excluded by default because most schools do not teach
# on it; add 7 there to enable it rather than special-casing it in code.
SCHEDULE_ALLOWED_DAYS=1,2,3,4,5,6
SCHEDULE_MAX_LESSONS_PER_DAY=12

# Administrator MFA is not implemented. ADMIN_MFA_REQUIRED=true keeps
# `platform:readiness` fail-closed on that gap; set it to false only to record
# a named, time-boxed exception accepted by the owner.
ADMIN_MFA_REQUIRED=true

CACHE_STORE=database
# CACHE_LIMITER names the rate-limiter backing store and defaults to
# CACHE_STORE. In production set it to `rate_limits` so throttling counters
# live on their own Redis connection and survive a cache flush.
# CACHE_LIMITER=rate_limits
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_RATE_LIMIT_DB=3
REDIS_REQUIRED_IN_PRODUCTION=true
REDIS_QUEUE_CONNECTION=queue
REDIS_CACHE_CONNECTION=cache
REDIS_RATE_LIMIT_CONNECTION=rate_limits

# Queue worker contract. retry_after must stay strictly greater than the
# worker timeout, otherwise the same job can run in two workers at once.
QUEUE_WORKER_QUEUES=notifications,media,maintenance
QUEUE_WORKER_TIMEOUT=150
QUEUE_WORKER_TRIES=3
QUEUE_WORKER_SLEEP=1
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_MONITOR_THRESHOLD=100
# Failed-job pruning removes failure evidence, so it is off unless a
# retention window is explicitly configured.
# QUEUE_PRUNE_FAILED_AFTER_DAYS=90
# QUEUE_FAILED_DRIVER=database-uuids

# Optional MariaDB read replica. Leave unset for a single-node deployment.
# DB_READ_HOST=
# DB_READ_PORT=3306
# DB_READ_USERNAME=
# DB_READ_PASSWORD=
# DB_WRITE_HOST=
# DB_CONNECT_TIMEOUT=5
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/mariadb-ca.pem

HEALTH_CHECK_TIMEOUT_SECONDS=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
